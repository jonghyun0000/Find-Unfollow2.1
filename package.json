{
  "name": "insta-analyzer",
  "version": "2.2.0",
  "private": true,
  "description": "Private Instagram relationship and snapshot comparison",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/generate-sw.mjs",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "13.4.0",
    "idb": "8.0.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
